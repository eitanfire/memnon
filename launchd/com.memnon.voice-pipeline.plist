<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.memnon.voice-pipeline</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__PROJECT_ROOT__/src/voice_pipeline.py</string>
    <string>watch</string>
    <string>--config</string>
    <string>__PROJECT_ROOT__/config.json</string>
    <string>--once</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/runtime/launchd.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/runtime/launchd.stderr.log</string>
</dict>
</plist>
