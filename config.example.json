{
  "runtime_dir": "./runtime",
  "state_file": "./runtime/state.json",
  "raw_audio_dir": "/Users/your-username/Library/Mobile Documents/com~apple~CloudDocs/Voice Inbox/raw",
  "archive_audio_dir": "/Users/your-username/Library/Mobile Documents/com~apple~CloudDocs/Voice Inbox/processed",
  "failed_audio_dir": "/Users/your-username/Library/Mobile Documents/com~apple~CloudDocs/Voice Inbox/failed",
  "obsidian_inbox_dir": "/Users/your-username/Documents/Obsidian/YourVault/Inbox/Voice",
  "tag_reference_dirs": [
    "/Users/your-username/Documents/Obsidian/YourVault"
  ],
  "note_template_path": "./templates/voice-note.md",
  "poll_seconds": 30,
  "min_stable_age_seconds": 90,
  "archive_subdirs_by_date": true,
  "min_audio_bytes": 4096,
  "min_transcript_words": 3,
  "audio_extensions": [
    ".m4a",
    ".mp3",
    ".wav",
    ".mp4",
    ".mpeg",
    ".mpga",
    ".webm",
    ".aac",
    ".flac"
  ],
  "transcription": {
    "backend": "command",
    "command_template": [
      "./src/transcribe.sh",
      "{input_path}",
      "{output_prefix}",
      "/opt/homebrew/share/whisper-cpp/models/ggml-base.en.bin",
      "{language}"
    ],
    "transcript_file_template": "{output_prefix}.txt",
    "language": "en"
  },
  "ai": {
    "enabled": false,
    "_comment_backend": "Options: openai_http | ollama_http | mock",
    "backend": "openai_http",
    "model": "gpt-4o-mini",
    "api_key": "sk-...",
    "temperature": 0.2,
    "timeout_seconds": 60,
    "max_tags": 5
  },
  "_comment_wisdom": "Optional. Point to a directory of corpus .md files (Plato, Torah, Stoics, etc.) — keep this outside the repo alongside your other private config. Reflect lane notes will trigger a second AI pass that selects resonant passages and generates a podcast script + guided meditation.",
  "wisdom_corpus_dir": "~/.codex/wisdom/corpus",
  "wisdom_template_path": "~/.codex/wisdom/wisdom-note.md",
  "_comment_lanes": "Optional. Define workflow lanes for post-ingest routing. Say the lane name as the first word of your recording to force a lane (e.g. 'Professional: just met Sarah...'). Falls back to keyword matching, then default.",
  "lanes": {
    "reflect": {
      "label": "reflect",
      "keywords": ["feeling", "insight", "pattern", "gratitude", "philosophical", "meditation", "mindset", "emotion", "awareness", "intention"],
      "keyword_threshold": 2
    },
    "professional": {
      "label": "professional",
      "keywords": ["meeting", "networking", "opportunity", "career", "colleague", "client", "hire", "interview", "resume", "follow up"],
      "keyword_threshold": 2
    },
    "build": {
      "label": "build",
      "keywords": ["code", "bug", "feature", "deploy", "refactor", "architecture", "engineering", "sprint", "pull request", "api"],
      "keyword_threshold": 2
    }
  },
  "_comment_lane_actions": "Optional per-lane downstream actions. append_jsonl writes a structured JSONL entry. generate_wisdom_note triggers corpus-based synthesis for reflect notes.",
  "lane_actions": {
    "professional": {
      "append_jsonl": "/Users/your-username/.codex/professional/memnon-intake.jsonl"
    },
    "reflect": {
      "generate_wisdom_note": true
    }
  },
  "gpt_handoff": {
    "enabled": true,
    "audio_dir": "/Users/your-username/Library/Mobile Documents/com~apple~CloudDocs/Voice Inbox/gpt-now",
    "export_dir": "./runtime/gpt-handoff",
    "template_path": "./templates/gpt-handoff.md",
    "copy_to_clipboard": true,
    "instructions": "Continue the active conversation using the transcript as source of truth. Answer the user's latest question first, then add any useful follow-up or clarifying questions."
  }
}
